# Copy to .env. Never commit .env.

# Empty or "pglite:<folder>" = embedded PostgreSQL for development (no install needed).
# Production: postgres://user:pass@host:5432/forcepulse
DATABASE_URL=pglite:.data/pglite

PORT=4000
NODE_ENV=development

# Long random strings (openssl rand -hex 32). Different per environment.
JWT_SECRET=change-me-dev-only-jwt-secret-0000000000
OTP_SECRET=change-me-dev-only-otp-secret-0000000000

# console = print OTPs in the server log and return them to the app (development only).
OTP_PROVIDER=console

# Web app origin allowed to call the API (CORS)
WEB_ORIGIN=http://localhost:3000

# First super admin, created by `npm run db:seed` if missing
SEED_SUPER_ADMIN_EMAIL=superadmin@forcepulse.local
SEED_SUPER_ADMIN_PASSWORD=change-me-on-first-login

# Local folder for uploaded photos and proofs (development)
UPLOAD_DIR=.data/uploads

# Razorpay TEST keys (rzp_test_...). Live keys are refused unless NODE_ENV=production.
# Dashboard > Account & Settings > API Keys, and > Webhooks for the webhook secret.
# Leave all three empty to run without payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 64 hex characters, encrypts organiser bank account numbers: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYOUT_ENCRYPTION_KEY=

# Optional. Set when the API runs on more than one server (live updates go through Redis).
# Local: docker run -d --name force-pulse-redis -p 6379:6379 redis:7.4-alpine
REDIS_URL=
