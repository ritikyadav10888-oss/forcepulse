{
  "name": "force-pulse-platform",
  "private": true,
  "description": "Force Pulse backend: API, database and shared code",
  "workspaces": [
    "packages/shared",
    "packages/scoring",
    "packages/db",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "tsc -b packages/shared packages/scoring packages/db apps/api",
    "typecheck": "tsc -b packages/shared packages/scoring packages/db apps/api",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev -w @force-pulse/api",
    "db:generate": "npm run generate -w @force-pulse/db",
    "db:migrate": "npm run migrate -w @force-pulse/db",
    "db:seed": "npm run seed -w @force-pulse/db",
    "demo": "npm run demo -w @force-pulse/api",
    "dev:web": "npm run dev -w @force-pulse/web",
    "web": "npm run dev -w @force-pulse/web"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
